<!-- language: xml -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.mapper.EtfMarketKlineMapper">
    <select id="pageWithEtfName" resultType="com.demo.vo.EtfMarketKlineWithNameVO">
        SELECT k.*, m.symbol AS etfName
        FROM etf_market_kline k
        LEFT JOIN etf_security_master m ON k.etf_code = m.etf_code
        <where>
            <if test="etfCode != null and etfCode != ''">
                AND k.etf_code LIKE CONCAT('%', #{etfCode}, '%')
            </if>
            <if test="etfName != null and etfName != ''">
                AND m.symbol LIKE CONCAT('%', #{etfName}, '%')
            </if>
            <if test="period != null and period != ''">
                AND k.period = #{period}
            </if>
            <if test="tradeTimeDate != null and tradeTimeDate != ''">
                AND DATE(k.trade_time) = #{tradeTimeDate}
            </if>
        </where>
        <choose>
            <when test="sortField == 'id'">ORDER BY k.id</when>
            <when test="sortField == 'etfCode'">ORDER BY k.etf_code</when>
            <when test="sortField == 'etfName'">ORDER BY m.symbol</when>
            <when test="sortField == 'period'">ORDER BY k.period</when>
            <when test="sortField == 'tradeTime'">ORDER BY k.trade_time</when>
            <when test="sortField == 'closePrice'">ORDER BY k.close_price</when>
            <when test="sortField == 'volume'">ORDER BY k.volume</when>
            <otherwise>ORDER BY k.trade_time DESC</otherwise>
        </choose>
        <if test="sortField != null and sortField != ''">
            <choose>
                <when test="sortOrder == 'asc'"> ASC</when>
                <otherwise> DESC</otherwise>
            </choose>
        </if>
        LIMIT #{offset}, #{size}
    </select>

    <select id="countWithEtfName" resultType="long">
        SELECT COUNT(1)
        FROM etf_market_kline k
        LEFT JOIN etf_security_master m ON k.etf_code = m.etf_code
        <where>
            <if test="etfCode != null and etfCode != ''">
                AND k.etf_code LIKE CONCAT('%', #{etfCode}, '%')
            </if>
            <if test="etfName != null and etfName != ''">
                AND m.symbol LIKE CONCAT('%', #{etfName}, '%')
            </if>
            <if test="period != null and period != ''">
                AND k.period = #{period}
            </if>
            <if test="tradeTimeDate != null and tradeTimeDate != ''">
                AND DATE(k.trade_time) = #{tradeTimeDate}
            </if>
        </where>
    </select>
</mapper>
